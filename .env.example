# Copy to .env (which git ignores) and fill in. These are read at build time for the legal notice.
# Put every value in double quotes. In the GitHub workflow the same values come from repository
# secrets named PROVIDER_NAME, PROVIDER_STREET, PROVIDER_POSTCODE, PROVIDER_CITY, PROVIDER_EMAIL and PROVIDER_PHONE.
HUGO_PROVIDER_NAME="Full Name"
HUGO_PROVIDER_STREET="Street and number"
HUGO_PROVIDER_POSTCODE="00000"
HUGO_PROVIDER_CITY="City"
HUGO_PROVIDER_EMAIL="contact@example.com"
HUGO_PROVIDER_PHONE="+49 000 0000 0000"
